{
  "name": "mobicat-jewels",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "jewels.mobicat.club",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/share",
      "/s/*"
    ]
  },
  "main": "worker.js",
  "kv_namespaces": [
    {
      "binding": "PREVIEWS",
      "id": "8fbcb75d33804aefbcd50fdc889f6104"
    }
  ],
  "ratelimits": [
    {
      "name": "SHARE_LIMIT",
      "namespace_id": "19031",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
